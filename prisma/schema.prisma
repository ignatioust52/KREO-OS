// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  businessMemberships BusinessMember[]
}

model Business {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  currency    String   @default("UGX")
  country     String   @default("UGANDA")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      BusinessMember[]
  clients      Client[]
  projects     Project[]
  services     Service[]
  invoices     Invoice[]
  expenses     Expense[]
  payments     Payment[]
  quotes       Quote[]
  contracts    Contract[]
}



model BusinessMember {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       String   @default("MEMBER")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Client {
  id         String   @id @default(uuid())
  businessId String
  name       String
  company    String?
  type       String?  // Individual, Business, etc.
  email      String?
  phone      String?
  whatsapp   String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projects   Project[]
  invoices   Invoice[]
  payments   Payment[]
  quotes     Quote[]
  contracts  Contract[]
}

model Project {
  id          String    @id @default(uuid())
  businessId  String
  clientId    String
  name        String
  type        String?
  status      String    @default("LEAD")
  value       Decimal   @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)

  tasks       Task[]
  deliverables Deliverable[]
  invoices    Invoice[]
  payments    Payment[]
  expenses    Expense[]
  quotes      Quote[]
  contracts   Contract[]
}

model Task {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      String    @default("TODO")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Deliverable {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      String    @default("PLANNED")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Quote {
  id          String    @id @default(uuid())
  businessId  String
  clientId    String
  projectId   String?
  totalAmount Decimal
  status      String    @default("DRAFT")
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Contract {
  id          String    @id @default(uuid())
  businessId  String
  clientId    String
  projectId   String?
  content     String
  status      String    @default("DRAFT")
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Invoice {
  id          String    @id @default(uuid())
  businessId  String
  clientId    String
  projectId   String?
  invoiceNumber String
  issueDate   DateTime
  dueDate     DateTime
  totalAmount Decimal
  amountPaid  Decimal   @default(0)
  currency    String
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  payments    Payment[]
}

model Payment {
  id          String    @id @default(uuid())
  businessId  String
  clientId    String
  projectId   String?
  invoiceId   String?
  amount      Decimal
  currency    String
  method      String
  reference   String?
  date        DateTime  @default(now())
  status      String    @default("SUCCESSFUL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Expense {
  id          String    @id @default(uuid())
  businessId  String
  projectId   String?
  category    String
  amount      Decimal
  currency    String
  vendor      String?
  date        DateTime
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Service {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  category    String?
  defaultPrice Decimal  @default(0)
  unit        String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
